# LM Studio yerel sunucusu
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_MODEL=qwen/qwen3.5-9b
# Etkileşimli ekranlar (CV Koçu, Mülakat Provası) için isteğe bağlı hızlı model (boşsa LM_MODEL)
LM_FAST_MODEL=
LM_REASONING_EFFORT=none
# Sesli mülakat provası (yerel macOS TTS + mlx-whisper)
TTS_VOICE=Yelda
WHISPER_MODEL=mlx-community/whisper-small-mlx
# Otomatik İlan Avcısı (dakika, ön yazı/özel CV hazırlık eşiği)
JOBBOT_INTERVAL_MIN=120
JOBBOT_PREP_MIN_SCORE=75
# Aday adı (ön yazılarda kullanılır)
CANDIDATE_NAME=Ad Soyad
LOG_LEVEL=INFO
